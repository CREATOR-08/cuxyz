{
    "String Matching: KMP": {
        "prefix": "kmp",
        "description": "Knuth-Morris-Pratt string matching",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    public static List<Integer> kmpSearch(String text, String pat) {",
            "        List<Integer> res = new ArrayList<>();",
            "        int m = pat.length(), n = text.length();",
            "        int[] lps = new int[m];",
            "        int len = 0, p = 1;",
            "        while (p < m) {",
            "            if (pat.charAt(p) == pat.charAt(len)) lps[p++] = ++len;",
            "            else if (len != 0) len = lps[len - 1];",
            "            else lps[p++] = 0;",
            "        }",
            "        int i = 0, j = 0;",
            "        while (i < n) {",
            "            if (text.charAt(i) == pat.charAt(j)) { i++; j++; }",
            "            if (j == m) {",
            "                res.add(i - j);",
            "                j = lps[j - 1];",
            "            } else if (i < n && text.charAt(i) != pat.charAt(j)) {",
            "                if (j != 0) j = lps[j - 1];",
            "                else i++;",
            "            }",
            "        }",
            "        return res;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        String text = \"DAACABCDBA\", pat = \"CAB\";",
            "        System.out.println(\"KMP Matches at indices: \" + kmpSearch(text, pat));",
            "    }",
            "}"
        ]
    },
    "String Matching: Rabin-Karp": {
        "prefix": "rabin",
        "description": "Rabin-Karp rolling hash string matching",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static int b = 26, p = 101;",
            "",
            "    static int getHash(String s) {",
            "        int l = s.length(), hash = 0;",
            "        for (int i = 0; i < l; i++) {",
            "            int r = s.charAt(i) - 'A' + 1;",
            "            int power = (int) Math.pow(b, l - i - 1) % p;",
            "            hash = (hash + (r * power) % p) % p;",
            "        }",
            "        return hash;",
            "    }",
            "",
            "    public static List<Integer> rabinKarpSearch(String text, String pat) {",
            "        List<Integer> res = new ArrayList<>();",
            "        int n = text.length(), l = pat.length();",
            "        int hPat = getHash(pat);",
            "        for (int i = 0; i <= n - l; i++) {",
            "            String sub = text.substring(i, i + l);",
            "            if (getHash(sub) == hPat && sub.equals(pat)) res.add(i);",
            "        }",
            "        return res;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        String text = \"DAACABCDBA\", pat = \"CAB\";",
            "        System.out.println(\"Rabin-Karp Matches at indices: \" + rabinKarpSearch(text, pat));",
            "    }",
            "}"
        ]
    },
    "Convex Hull: Graham Scan": {
        "prefix": "graham",
        "description": "Graham's Scan Convex Hull O(n log n) sorting",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class Point {",
            "        double x, y;",
            "        Point(double x, double y) { this.x = x; this.y = y; }",
            "        @Override public String toString() { return \"(\" + (int)x + \",\" + (int)y + \")\"; }",
            "    }",
            "",
            "    static double cross(Point a, Point b, Point c) {",
            "        return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);",
            "    }",
            "",
            "    static double distSq(Point a, Point b) {",
            "        return (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y);",
            "    }",
            "",
            "    public static List<Point> grahamsScan(List<Point> pts) {",
            "        if (pts == null || pts.size() <= 1) return new ArrayList<>(pts);",
            "",
            "        Point p0 = pts.get(0);",
            "        for (Point p : pts) {",
            "            if (p.y < p0.y || (p.y == p0.y && p.x < p0.x)) p0 = p;",
            "        }",
            "",
            "        final Point base = p0;",
            "        List<Point> sorted = new ArrayList<>();",
            "",
            "        for (Point p : pts) {",
            "            if (p != base && !sorted.stream().anyMatch(q -> q.x == p.x && q.y == p.y)) {",
            "                sorted.add(p);",
            "            }",
            "        }",
            "",
            "        sorted.sort((p1, p2) -> {",
            "            double cp = cross(base, p1, p2);",
            "            if (Math.abs(cp) < 1e-9) {",
            "                return Double.compare(distSq(base, p1), distSq(base, p2));",
            "            }",
            "            return cp > 0 ? -1 : 1;",
            "        });",
            "",
            "        Stack<Point> stack = new Stack<>();",
            "        stack.push(base);",
            "",
            "        for (Point p : sorted) {",
            "            while (stack.size() >= 2 &&",
            "                   cross(stack.get(stack.size() - 2), stack.peek(), p) <= 0) {",
            "                stack.pop();",
            "            }",
            "            stack.push(p);",
            "        }",
            "",
            "        return new ArrayList<>(stack);",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        List<Point> pts = Arrays.asList(",
            "            new Point(0, 0), new Point(0, 4), new Point(-4, 0),",
            "            new Point(5, 0), new Point(0, -6), new Point(1, 0)",
            "        );",
            "",
            "        System.out.println(\"Graham's Scan Hull: \" + grahamsScan(pts));",
            "    }",
            "}"
        ]
    },


    "Convex Hull: Jarvis March": {
        "prefix": "jarvis",
        "description": "Jarvis March / Gift Wrapping Convex Hull O(nh)",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class Point {",
            "        double x, y;",
            "        Point(double x, double y) { this.x = x; this.y = y; }",
            "        @Override public String toString() { return \"(\" + (int)x + \",\" + (int)y + \")\"; }",
            "    }",
            "",
            "    static double cross(Point a, Point b, Point c) {",
            "        return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);",
            "    }",
            "",
            "    static double distSq(Point a, Point b) {",
            "        return (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y);",
            "    }",
            "",
            "    public static List<Point> jarvisMarch(List<Point> pts) {",
            "        List<Point> hull = new ArrayList<>();",
            "        if (pts == null || pts.isEmpty()) return hull;",
            "",
            "        int n = pts.size();",
            "        if (n <= 2) return new ArrayList<>(new LinkedHashSet<>(pts));",
            "",
            "        int l = 0;",
            "        for (int i = 1; i < n; i++) {",
            "            if (pts.get(i).x < pts.get(l).x ||",
            "                (pts.get(i).x == pts.get(l).x && pts.get(i).y < pts.get(l).y)) l = i;",
            "        }",
            "",
            "        int p = l, q;",
            "        do {",
            "            hull.add(pts.get(p));",
            "            q = (p + 1) % n;",
            "",
            "            for (int i = 0; i < n; i++) {",
            "                double cp = cross(pts.get(p), pts.get(i), pts.get(q));",
            "                if (cp > 1e-9 ||",
            "                    (Math.abs(cp) <= 1e-9 && distSq(pts.get(p), pts.get(i)) > distSq(pts.get(p), pts.get(q)))) {",
            "                    q = i;",
            "                }",
            "            }",
            "",
            "            p = q;",
            "        } while (p != l);",
            "",
            "        return hull;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        List<Point> pts = Arrays.asList(",
            "            new Point(0, 0), new Point(0, 4), new Point(-4, 0),",
            "            new Point(5, 0), new Point(0, -6), new Point(1, 0)",
            "        );",
            "",
            "        System.out.println(\"Jarvis March Hull: \" + jarvisMarch(pts));",
            "    }",
            "}"
        ]
    },


    "Convex Hull: Divide and Conquer": {
        "prefix": "dnc-hull",
        "description": "Recursive Divide and Conquer Convex Hull O(n log n)",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class Point implements Comparable<Point> {",
            "        double x, y;",
            "        Point(double x, double y) { this.x = x; this.y = y; }",
            "        @Override public int compareTo(Point p) {",
            "            if (x != p.x) return Double.compare(x, p.x);",
            "            return Double.compare(y, p.y);",
            "        }",
            "        @Override public String toString() { return \"(\" + (int)x + \",\" + (int)y + \")\"; }",
            "    }",
            "",
            "    static double cross(Point a, Point b, Point c) {",
            "        return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);",
            "    }",
            "",
            "    static List<Point> chain(List<Point> pts, boolean lower) {",
            "        List<Point> hull = new ArrayList<>();",
            "        int n = pts.size();",
            "        for (int i = 0; i < n; i++) {",
            "            Point p = pts.get(lower ? i : n - 1 - i);",
            "            while (hull.size() >= 2 && cross(hull.get(hull.size() - 2), hull.get(hull.size() - 1), p) <= 0) {",
            "                hull.remove(hull.size() - 1);",
            "            }",
            "            hull.add(p);",
            "        }",
            "        return hull;",
            "    }",
            "",
            "    static List<Point> mergeSorted(List<Point> a, List<Point> b) {",
            "        List<Point> res = new ArrayList<>();",
            "        int i = 0, j = 0;",
            "        while (i < a.size() || j < b.size()) {",
            "            Point p;",
            "            if (j == b.size() || (i < a.size() && a.get(i).compareTo(b.get(j)) < 0)) p = a.get(i++);",
            "            else if (i == a.size() || b.get(j).compareTo(a.get(i)) < 0) p = b.get(j++);",
            "            else { p = a.get(i++); j++; }",
            "            if (res.isEmpty() || res.get(res.size() - 1).compareTo(p) != 0) res.add(p);",
            "        }",
            "        return res;",
            "    }",
            "",
            "    static List<Point> mergeHulls(List<Point> left, List<Point> right) {",
            "        List<Point> all = mergeSorted(left, right);",
            "        List<Point> lower = chain(all, true);",
            "        List<Point> upper = chain(all, false);",
            "        Collections.reverse(upper);",
            "        return mergeSorted(lower, upper);",
            "    }",
            "",
            "    static List<Point> solve(List<Point> pts, int l, int r) {",
            "        if (l == r) return new ArrayList<>(Arrays.asList(pts.get(l)));",
            "        if (r == l + 1) return new ArrayList<>(Arrays.asList(pts.get(l), pts.get(r)));",
            "",
            "        int mid = l + (r - l) / 2;",
            "        List<Point> left = solve(pts, l, mid);",
            "        List<Point> right = solve(pts, mid + 1, r);",
            "",
            "        return mergeHulls(left, right);",
            "    }",
            "",
            "    public static List<Point> divideAndConquer(List<Point> pts) {",
            "        if (pts == null || pts.isEmpty()) return new ArrayList<>();",
            "",
            "        List<Point> sorted = new ArrayList<>(new TreeSet<>(pts));",
            "        int n = sorted.size();",
            "        if (n <= 2) return sorted;",
            "",
            "        List<Point> hull = solve(sorted, 0, n - 1);",
            "        List<Point> lower = chain(hull, true);",
            "        List<Point> upper = chain(hull, false);",
            "",
            "        lower.remove(lower.size() - 1);",
            "        upper.remove(upper.size() - 1);",
            "        lower.addAll(upper);",
            "",
            "        return lower;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        List<Point> pts = Arrays.asList(",
            "            new Point(0, 0), new Point(0, 4), new Point(-4, 0),",
            "            new Point(5, 0), new Point(0, -6), new Point(1, 0)",
            "        );",
            "",
            "        System.out.println(\"Divide and Conquer Hull: \" + divideAndConquer(pts));",
            "    }",
            "}"
        ]
    },
    "Geometry: Closest Pair of Points": {
        "prefix": "closest",
        "description": "Divide and Conquer Closest Pair of Points O(n log n)",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class Point {",
            "        double x, y;",
            "        Point(double x, double y) { this.x = x; this.y = y; }",
            "    }",
            "    static double dist(Point a, Point b) { return Math.hypot(a.x - b.x, a.y - b.y); }",
            "",
            "    static double closest(Point[] pts, int l, int r) {",
            "        if (r - l <= 3) {",
            "            double min = Double.MAX_VALUE;",
            "            for (int i = l; i <= r; i++)",
            "                for (int j = i + 1; j <= r; j++) min = Math.min(min, dist(pts[i], pts[j]));",
            "            return min;",
            "        }",
            "        int mid = (l + r) / 2;",
            "        double d = Math.min(closest(pts, l, mid), closest(pts, mid + 1, r));",
            "        List<Point> strip = new ArrayList<>();",
            "        for (int i = l; i <= r; i++) {",
            "            if (Math.abs(pts[i].x - pts[mid].x) < d) strip.add(pts[i]);",
            "        }",
            "        strip.sort(Comparator.comparingDouble(p -> p.y));",
            "        for (int i = 0; i < strip.size(); i++) {",
            "            for (int j = i + 1; j < strip.size() && (strip.get(j).y - strip.get(i).y) < d; j++) {",
            "                d = Math.min(d, dist(strip.get(i), strip.get(j)));",
            "            }",
            "        }",
            "        return d;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        Point[] pts = {",
            "            new Point(2, 3), new Point(12, 30), new Point(40, 50),",
            "            new Point(5, 1), new Point(12, 10), new Point(3, 4)",
            "        };",
            "        Arrays.sort(pts, Comparator.comparingDouble(p -> p.x));",
            "        System.out.printf(\"Minimum Distance: %.4f%n\", closest(pts, 0, pts.length - 1));",
            "    }",
            "}"
        ]
    },
    "Graph: All Cliques DFS": {
        "prefix": "clique",
        "description": "Find all cliques in undirected graph using DFS traversal",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static List<List<Integer>> cliques = new ArrayList<>();",
            "",
            "    static void findCliques(int start, List<Integer> curr, int n, boolean[][] adj) {",
            "        for (int v = start; v <= n; v++) {",
            "            boolean ok = true;",
            "            for (int u : curr) { if (!adj[u][v]) { ok = false; break; } }",
            "            if (ok) {",
            "                curr.add(v);",
            "                cliques.add(new ArrayList<>(curr));",
            "                findCliques(v + 1, curr, n, adj);",
            "                curr.remove(curr.size() - 1);",
            "            }",
            "        }",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        int n = 9;",
            "        boolean[][] adj = new boolean[n + 1][n + 1];",
            "        int[][] edges = {{1,2},{1,3},{1,4},{2,3},{3,4},{4,5},{4,6},{5,6},{5,7},{5,8},{6,7},{6,8},{7,8},{7,9}};",
            "        for (int[] e : edges) { adj[e[0]][e[1]] = adj[e[1]][e[0]] = true; }",
            "        findCliques(1, new ArrayList<>(), n, adj);",
            "        System.out.println(\"Total Cliques Count: \" + cliques.size());",
            "        System.out.println(\"Cliques (size >= 3): \" + cliques.stream().filter(c -> c.size() >= 3).toList());",
            "    }",
            "}"
        ]
    },


    "Tree: Range Search on AVL Tree": {
        "prefix": "range-tree",
        "description": "1D Range Search using AVL Tree with rotations O(log n + k)",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class Node {",
            "        int key, height;",
            "        Node left, right;",
            "        Node(int key) { this.key = key; height = 1; }",
            "    }",
            "",
            "    static int height(Node n) {",
            "        return n == null ? 0 : n.height;",
            "    }",
            "",
            "    static int balance(Node n) {",
            "        return n == null ? 0 : height(n.left) - height(n.right);",
            "    }",
            "",
            "    static Node rightRotate(Node y) {",
            "        Node x = y.left;",
            "        Node t = x.right;",
            "        x.right = y;",
            "        y.left = t;",
            "        y.height = 1 + Math.max(height(y.left), height(y.right));",
            "        x.height = 1 + Math.max(height(x.left), height(x.right));",
            "        return x;",
            "    }",
            "",
            "    static Node leftRotate(Node x) {",
            "        Node y = x.right;",
            "        Node t = y.left;",
            "        y.left = x;",
            "        x.right = t;",
            "        x.height = 1 + Math.max(height(x.left), height(x.right));",
            "        y.height = 1 + Math.max(height(y.left), height(y.right));",
            "        return y;",
            "    }",
            "",
            "    static Node insert(Node root, int key) {",
            "        if (root == null) return new Node(key);",
            "",
            "        if (key < root.key) root.left = insert(root.left, key);",
            "        else if (key > root.key) root.right = insert(root.right, key);",
            "        else return root;",
            "",
            "        root.height = 1 + Math.max(height(root.left), height(root.right));",
            "        int b = balance(root);",
            "",
            "        if (b > 1 && key < root.left.key) return rightRotate(root);",
            "        if (b < -1 && key > root.right.key) return leftRotate(root);",
            "        if (b > 1 && key > root.left.key) {",
            "            root.left = leftRotate(root.left);",
            "            return rightRotate(root);",
            "        }",
            "        if (b < -1 && key < root.right.key) {",
            "            root.right = rightRotate(root.right);",
            "            return leftRotate(root);",
            "        }",
            "",
            "        return root;",
            "    }",
            "",
            "    static void rangeSearch(Node root, int low, int high, List<Integer> res) {",
            "        if (root == null) return;",
            "",
            "        if (root.key > low) rangeSearch(root.left, low, high, res);",
            "        if (root.key >= low && root.key <= high) res.add(root.key);",
            "        if (root.key < high) rangeSearch(root.right, low, high, res);",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        int[] vals = {49, 23, 80, 10, 37, 62, 89, 3, 19, 30, 59, 70, 100, 105};",
            "        Node root = null;",
            "",
            "        for (int v : vals) root = insert(root, v);",
            "",
            "        int low = 18, high = 77;",
            "        List<Integer> res = new ArrayList<>();",
            "        rangeSearch(root, low, high, res);",
            "",
            "        System.out.println(\"Nodes in range [\" + low + \", \" + high + \"]: \" + res);",
            "    }",
            "}"
        ]
    },

    "KD-Tree: 2D Builder": {
        "prefix": "kdtree-build",
        "description": "Recursive 2D KD-Tree Builder with median partitions",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class KDNode {",
            "        int[] p;",
            "        KDNode left, right;",
            "        KDNode(int[] p) { this.p = p; }",
            "    }",
            "",
            "    public static KDNode buildKD(List<int[]> pts, int depth) {",
            "        if (pts.isEmpty()) return null;",
            "        int axis = depth % 2;",
            "        pts.sort(Comparator.comparingInt(p -> p[axis]));",
            "        int mid = pts.size() / 2;",
            "        int[] median = pts.get(mid);",
            "        System.out.printf(\"Depth %d | %s-axis split | Node: %s%n\", depth, (axis == 0 ? \"X\" : \"Y\"), Arrays.toString(median));",
            "        KDNode node = new KDNode(median);",
            "        node.left = buildKD(new ArrayList<>(pts.subList(0, mid)), depth + 1);",
            "        node.right = buildKD(new ArrayList<>(pts.subList(mid + 1, pts.size())), depth + 1);",
            "        return node;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        List<int[]> pts = new ArrayList<>(Arrays.asList(",
            "            new int[]{1,9}, new int[]{2,3}, new int[]{4,1}, new int[]{3,7},",
            "            new int[]{5,4}, new int[]{6,8}, new int[]{7,2}, new int[]{8,8},",
            "            new int[]{7,9}, new int[]{9,6}",
            "        ));",
            "        System.out.println(\"--- 2D KD-Tree Partitioning ---\");",
            "        buildKD(pts, 0);",
            "    }",
            "}"
        ]
    },
    "KD-Tree: Range Search": {
        "prefix": "kdtree-search",
        "description": "Orthogonal range search in 2D KD-Tree",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static class KDNode {",
            "        int[] p; int depth;",
            "        KDNode left, right;",
            "        KDNode(int[] p, int depth) { this.p = p; this.depth = depth; }",
            "    }",
            "",
            "    public static KDNode insert(KDNode root, int[] p, int depth) {",
            "        if (root == null) return new KDNode(p, depth);",
            "        int axis = depth % 2;",
            "        if (p[axis] < root.p[axis]) root.left = insert(root.left, p, depth + 1);",
            "        else root.right = insert(root.right, p, depth + 1);",
            "        return root;",
            "    }",
            "",
            "    public static void searchKD(KDNode root, int[][] R, List<int[]> res) {",
            "        if (root == null) return;",
            "        int x = root.p[0], y = root.p[1];",
            "        if (x >= R[0][0] && x <= R[0][1] && y >= R[1][0] && y <= R[1][1]) res.add(root.p);",
            "        int axis = root.depth % 2;",
            "        if (R[axis][0] <= root.p[axis]) searchKD(root.left, R, res);",
            "        if (R[axis][1] >= root.p[axis]) searchKD(root.right, R, res);",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        KDNode root = null;",
            "        int[][] pts = {{1,9},{2,3},{4,1},{3,7},{5,4},{6,8},{7,2},{8,8},{7,9},{9,6}};",
            "        for (int[] p : pts) root = insert(root, p, 0);",
            "        int[][] R = {{3, 7}, {7, 9}};",
            "        List<int[]> res = new ArrayList<>();",
            "        searchKD(root, R, res);",
            "        System.out.print(\"Points in Range [[3,7],[7,9]]: \");",
            "        for (int[] p : res) System.out.print(Arrays.toString(p) + \" \");",
            "        System.out.println();",
            "    }",
            "}"
        ]
    },
    "Geometry: Monotone Polygon Check": {
        "prefix": "monotone",
        "description": "Check if a 2D polygon is X-monotone or Y-monotone",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static boolean isMonotone(List<int[]> poly, boolean checkX) {",
            "        int n = poly.size(), minIdx = 0, maxIdx = 0;",
            "        int idx = checkX ? 0 : 1;",
            "        for (int i = 1; i < n; i++) {",
            "            if (poly.get(i)[idx] < poly.get(minIdx)[idx]) minIdx = i;",
            "            if (poly.get(i)[idx] > poly.get(maxIdx)[idx]) maxIdx = i;",
            "        }",
            "        int curr = minIdx;",
            "        while (curr != maxIdx) {",
            "            int next = (curr + 1) % n;",
            "            if (poly.get(next)[idx] < poly.get(curr)[idx]) return false;",
            "            curr = next;",
            "        }",
            "        curr = maxIdx;",
            "        while (curr != minIdx) {",
            "            int next = (curr + 1) % n;",
            "            if (poly.get(next)[idx] > poly.get(curr)[idx]) return false;",
            "            curr = next;",
            "        }",
            "        return true;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        List<int[]> poly = Arrays.asList(new int[]{0,0}, new int[]{2,3}, new int[]{5,4}, new int[]{4,1}, new int[]{2,-1});",
            "        System.out.println(\"Is X-Monotone: \" + isMonotone(poly, true));",
            "        System.out.println(\"Is Y-Monotone: \" + isMonotone(poly, false));",
            "    }",
            "}"
        ]
    },
    "Approximation: Vertex Cover": {
        "prefix": "vc",
        "description": "Vertex Cover 2-approximation and greedy max-degree",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    public static Set<Integer> approxVertexCover(int n, List<int[]> edges) {",
            "        Set<Integer> cover = new HashSet<>();",
            "        boolean[] visitedEdge = new boolean[edges.size()];",
            "        for (int i = 0; i < edges.size(); i++) {",
            "            if (!visitedEdge[i]) {",
            "                int u = edges.get(i)[0], v = edges.get(i)[1];",
            "                if (!cover.contains(u) && !cover.contains(v)) {",
            "                    cover.add(u);",
            "                    cover.add(v);",
            "                    visitedEdge[i] = true;",
            "                }",
            "            }",
            "        }",
            "        return cover;",
            "    }",
            "",
            "    public static Set<Integer> greedyVertexCover(int n, List<int[]> edges) {",
            "        Set<Integer> cover = new HashSet<>();",
            "        List<int[]> remEdges = new ArrayList<>(edges);",
            "        while (!remEdges.isEmpty()) {",
            "            int[] deg = new int[n + 1];",
            "            for (int[] e : remEdges) { deg[e[0]]++; deg[e[1]]++; }",
            "            int maxV = 1;",
            "            for (int v = 2; v <= n; v++) if (deg[v] > deg[maxV]) maxV = v;",
            "            cover.add(maxV);",
            "            final int picked = maxV;",
            "            remEdges.removeIf(e -> e[0] == picked || e[1] == picked);",
            "        }",
            "        return cover;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        int n = 7;",
            "        List<int[]> edges = Arrays.asList(",
            "            new int[]{1,2}, new int[]{1,4}, new int[]{2,3}, new int[]{2,5},",
            "            new int[]{3,5}, new int[]{3,6}, new int[]{3,7}, new int[]{5,6}",
            "        );",
            "        System.out.println(\"Matching 2-Approx Cover: \" + approxVertexCover(n, edges));",
            "        System.out.println(\"Greedy Max-Degree Cover: \" + greedyVertexCover(n, edges));",
            "    }",
            "}"
        ]
    },
    

    "Approximation: TSP 2-Approximation": {
        "prefix": "tsp-approx",
        "description": "2-Approximation TSP using Prim's MST with PriorityQueue and Euler Tour",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static int n = 6;",
            "    static int[][] cost = new int[n + 1][n + 1];",
            "",
            "    static List<List<Integer>> primMST(int start) {",
            "        boolean[] visited = new boolean[n + 1];",
            "        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[1]));",
            "        List<List<Integer>> tree = new ArrayList<>();",
            "        for (int i = 0; i <= n; i++) tree.add(new ArrayList<>());",
            "",
            "        pq.offer(new int[]{start, 0, -1});",
            "        int count = 0;",
            "",
            "        while (!pq.isEmpty() && count < n) {",
            "            int[] cur = pq.poll();",
            "            int u = cur[0], parent = cur[2];",
            "",
            "            if (visited[u]) continue;",
            "            visited[u] = true;",
            "            count++;",
            "",
            "            if (parent != -1) {",
            "                tree.get(u).add(parent);",
            "                tree.get(parent).add(u);",
            "            }",
            "",
            "            for (int v = 1; v <= n; v++) {",
            "                if (cost[u][v] > 0 && !visited[v]) {",
            "                    pq.offer(new int[]{v, cost[u][v], u});",
            "                }",
            "            }",
            "        }",
            "",
            "        if (count != n) throw new IllegalArgumentException(\"Graph is disconnected\");",
            "        return tree;",
            "    }",
            "",
            "    static List<Integer> eulerTour(List<List<Integer>> tree, int start) {",
            "        List<Integer> tour = new ArrayList<>();",
            "        boolean[] visited = new boolean[n + 1];",
            "        dfs(start, tree, visited, tour);",
            "        tour.add(start);",
            "        return tour;",
            "    }",
            "",
            "    static void dfs(int u, List<List<Integer>> tree, boolean[] visited, List<Integer> tour) {",
            "        visited[u] = true;",
            "        tour.add(u);",
            "        for (int v : tree.get(u)) {",
            "            if (!visited[v]) dfs(v, tree, visited, tour);",
            "        }",
            "    }",
            "",
            "    public static List<Integer> tspApprox(int start) {",
            "        List<List<Integer>> mst = primMST(start);",
            "        return eulerTour(mst, start);",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        int[][] edges = {",
            "            {1,2,10}, {2,3,12}, {3,4,15}, {4,5,40},",
            "            {5,6,8}, {6,1,16}, {1,5,18}, {2,5,10}, {3,6,20}",
            "        };",
            "",
            "        for (int[] e : edges) {",
            "            cost[e[0]][e[1]] = cost[e[1]][e[0]] = e[2];",
            "        }",
            "",
            "        System.out.println(\"2-Approx TSP Tour: \" + tspApprox(1));",
            "    }",
            "}"
        ]
    },
    "Approximation: Load Balancing (LPT)": {
        "prefix": "load-balance",
        "description": "Machine load balancing using Longest Processing Time",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    public static int[] balanceLoad(int m, Integer[] jobs) {",
            "        Arrays.sort(jobs, Collections.reverseOrder());",
            "        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));",
            "        for (int i = 0; i < m; i++) pq.offer(new int[]{0, i});",
            "        for (int job : jobs) {",
            "            int[] top = pq.poll();",
            "            top[0] += job;",
            "            pq.offer(top);",
            "        }",
            "        int[] finalLoads = new int[m];",
            "        while (!pq.isEmpty()) {",
            "            int[] cur = pq.poll();",
            "            finalLoads[cur[1]] = cur[0];",
            "        }",
            "        return finalLoads;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        Integer[] jobs = {6, 4, 3, 2, 2, 2};",
            "        System.out.println(\"Machine Loads: \" + Arrays.toString(balanceLoad(3, jobs)));",
            "    }",
            "}"
        ]
    },
    "Approximation: Matrix Set Cover": {
        "prefix": "set-cover",
        "description": "Greedy approximation to cover non-zero matrix entries",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    public static List<Integer> matrixSetCover(int[][] mat) {",
            "        int rows = mat.length, cols = mat[0].length;",
            "        Set<String> uncovered = new HashSet<>();",
            "        for (int r = 0; r < rows; r++)",
            "            for (int c = 0; c < cols; c++) if (mat[r][c] != 0) uncovered.add(r + \",\" + c);",
            "        List<Integer> pickedRows = new ArrayList<>();",
            "        while (!uncovered.isEmpty()) {",
            "            int bestRow = -1, maxCover = -1;",
            "            for (int r = 0; r < rows; r++) {",
            "                int count = 0;",
            "                for (int c = 0; c < cols; c++) if (mat[r][c] != 0 && uncovered.contains(r + \",\" + c)) count++;",
            "                if (count > maxCover) { maxCover = count; bestRow = r; }",
            "            }",
            "            if (bestRow == -1 || maxCover == 0) break;",
            "            pickedRows.add(bestRow);",
            "            for (int c = 0; c < cols; c++) uncovered.remove(bestRow + \",\" + c);",
            "        }",
            "        return pickedRows;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        int[][] mat = {",
            "            {0, 5, 0, 2, 4, 0, 6, 1},",
            "            {8, 0, 5, 3, 0, 2, 1, 0},",
            "            {0, 6, 0, 5, 3, 4, 0, 8},",
            "            {0, 1, 5, 0, 9, 0, 0, 3}",
            "        };",
            "        System.out.println(\"Selected Rows for Set Cover: \" + matrixSetCover(mat));",
            "    }",
            "}"
        ]
    },
    "Heuristic: Genetic 0/1 Knapsack": {
        "prefix": "knapsack-ga",
        "description": "0/1 Knapsack solution using Genetic Algorithm",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    static int N = 20, W = 250, POP = 50, GENS = 100;",
            "    static int[] weights = new int[N], values = new int[N];",
            "    static Random rand = new Random(42);",
            "",
            "    static int fitness(int[] chr) {",
            "        int wt = 0, val = 0;",
            "        for (int i = 0; i < N; i++) if (chr[i] == 1) { wt += weights[i]; val += values[i]; }",
            "        return wt <= W ? val : 0;",
            "    }",
            "",
            "    public static void main(String[] args) {",
            "        for (int i = 0; i < N; i++) { weights[i] = rand.nextInt(99) + 1; values[i] = rand.nextInt(99) + 1; }",
            "        int[][] pop = new int[POP][N];",
            "        for (int i = 0; i < POP; i++) for (int j = 0; j < N; j++) pop[i][j] = rand.nextInt(2);",
            "        int bestVal = 0;",
            "        for (int g = 0; g < GENS; g++) {",
            "            int[][] next = new int[POP][N];",
            "            for (int i = 0; i < POP; i++) {",
            "                int[] p1 = pop[rand.nextInt(POP)], p2 = pop[rand.nextInt(POP)];",
            "                int[] parent = fitness(p1) > fitness(p2) ? p1 : p2;",
            "                int[] child = parent.clone();",
            "                if (rand.nextDouble() < 0.05) child[rand.nextInt(N)] ^= 1;",
            "                next[i] = child;",
            "                bestVal = Math.max(bestVal, fitness(child));",
            "            }",
            "            pop = next;",
            "        }",
            "        System.out.println(\"GA Knapsack Max Value: $\" + bestVal + \" (Capacity: \" + W + \" gm)\");",
            "    }",
            "}"
        ]
    },
    "Sorting: QuickSort with Median-of-Medians": {
        "prefix": "quick-median",
        "description": "QuickSort with deterministic O(n) Median-of-Medians pivot",
        "body": [
            "import java.util.*;",
            "",
            "public class ${TM_FILENAME_BASE} {",
            "    public static void quickSort(int[] arr, int l, int r) {",
            "        if (l < r) {",
            "            int pivotIdx = getMedianOfMedians(arr, l, r);",
            "            int p = partition(arr, l, r, pivotIdx);",
            "            quickSort(arr, l, p - 1);",
            "            quickSort(arr, p + 1, r);",
            "        }",
            "    }",
            "    static int partition(int[] arr, int l, int r, int pivotIdx) {",
            "        int pv = arr[pivotIdx];",
            "        swap(arr, pivotIdx, r);",
            "        int i = l;",
            "        for (int j = l; j < r; j++) if (arr[j] < pv) swap(arr, i++, j);",
            "        swap(arr, i, r);",
            "        return i;",
            "    }",
            "    static int getMedianOfMedians(int[] arr, int l, int r) {",
            "        int n = r - l + 1;",
            "        if (n <= 5) { Arrays.sort(arr, l, r + 1); return l + n / 2; }",
            "        List<Integer> medians = new ArrayList<>();",
            "        for (int i = l; i <= r; i += 5) {",
            "            int subR = Math.min(i + 4, r);",
            "            Arrays.sort(arr, i, subR + 1);",
            "            medians.add(arr[i + (subR - i) / 2]);",
            "        }",
            "        int medVal = medians.get(medians.size() / 2);",
            "        for (int i = l; i <= r; i++) if (arr[i] == medVal) return i;",
            "        return l;",
            "    }",
            "    static void swap(int[] arr, int i, int j) { int t = arr[i]; arr[i] = arr[j]; arr[j] = t; }",
            "",
            "    public static void main(String[] args) {",
            "        Random rand = new Random(42);",
            "        int[] arr = new int[100];",
            "        for (int i = 0; i < 100; i++) arr[i] = rand.nextInt(500) + 1;",
            "        quickSort(arr, 0, arr.length - 1);",
            "        System.out.println(\"Sorted 100 elements. First 10: \" + Arrays.toString(Arrays.copyOfRange(arr, 0, 10)));",
            "    }",
            "}"
        ]
    }
